# Copy to watchgrid.env (next to compose.yml) and fill in.

# Your PostgreSQL (use the NAS address, not localhost: the container has its own).
DATABASE_URL=postgres://watchgrid:CHANGE_ME@192.168.1.10:5432/watchgrid

# Time zone for logs; schedules use Settings → General in the web UI.
TZ=Europe/Bucharest

# Set to 1 when served over HTTPS (nginx or the DSM reverse proxy with a
# certificate): the session cookie is then never sent over plain HTTP.
WATCHGRID_SECURE_COOKIES=0

# Reverse proxy addresses (IPs or CIDR, comma-separated). Requests from them
# carry the real client in X-Forwarded-For (sessions list, sign-in limit).
# nginx on the NAS itself: 127.0.0.1. See deploy/nginx/watchgrid.conf.
#WATCHGRID_TRUSTED_PROXIES=127.0.0.1
