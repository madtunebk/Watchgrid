# /etc/watchgrid/watchgrid.env — root:watchgrid, mode 0640.
# Read by the service (EnvironmentFile=) and by `sudo watchgrid …` commands.

# PostgreSQL connection (this file holds the database password).
DATABASE_URL=postgres://watchgrid:CHANGE_ME@127.0.0.1:5432/watchgrid

# Where the web UI and API listen. 0.0.0.0 = reachable on the LAN.
WATCHGRID_BIND=0.0.0.0:8090

# Credential master key: encrypts camera passwords. Back it up with the
# database — without it, stored camera passwords can't be read.
WATCHGRID_KEY_FILE=/etc/watchgrid/master.key

# Server state and the default recordings folder. On a NAS, point the
# recordings at the big volume with: sudo watchgrid storage set-path /volume1/watchgrid
WATCHGRID_DATA_DIR=/var/lib/watchgrid
WATCHGRID_RECORDINGS_DIR=/var/lib/watchgrid/recordings

# Built web UI.
WATCHGRID_UI_DIR=/usr/share/watchgrid/ui

# Behind a TLS reverse proxy: its address (IPs or CIDR, comma-separated).
# HTTPS visitors then get Secure session cookies automatically.
#WATCHGRID_TRUSTED_PROXIES=127.0.0.1
# 1 = Secure cookies for everyone (plain-HTTP sign-in stops working).
#WATCHGRID_SECURE_COOKIES=1

# Log level: watchgrid=info (default), watchgrid=debug for troubleshooting.
RUST_LOG=watchgrid=info
